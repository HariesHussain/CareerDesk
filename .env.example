# OpportunityOS — Environment Variables Template
# Copy this file to .env and fill in real values. 
# SECURITY WARNING: NEVER commit .env itself or expose secret keys in client-side code!

# 1. External Opportunity API (Brabble)
# Server-side only — used exclusively by the background sync worker.
BRABBLE_API_KEY=brbl_your_64_hex_char_key_here

# 2. Supabase Cloud PostgreSQL Database
# Obtained from: Supabase Dashboard -> Project Settings -> API & Database
SUPABASE_URL=https://your-project-id.supabase.co
# Anon key: safe for browser client requests (governed by Row Level Security)
SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Service role key: SERVER-SIDE ONLY. Bypasses RLS for sync upserts & admin tasks. NEVER EXPOSE TO CLIENT!
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Direct connection or transaction pooler (port 6543 for serverless environments)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# 3. Application Security & Runtime
SECRET_KEY=generate_a_secure_random_64_byte_hex_string_here
FLASK_ENV=development
PORT=3000

# 4. Sync & Cron Security
# Secret token used by Vercel Cron or webhook to trigger sync securely: GET /api/cron/sync?token=YOUR_CRON_SECRET
CRON_SECRET=generate_a_secure_random_cron_secret_token_here
SYNC_INTERVAL_MINUTES=60

